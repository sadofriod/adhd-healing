// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IdeaSession {
  id         String   @id @default(uuid()) @db.Uuid
  status     String   @default("clarifying")
  turnCount  Int      @default(0) @map("turn_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  messages SessionMessage[]

  @@map("idea_sessions")
}

model SessionMessage {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id") @db.Uuid
  role      String
  inputMode String   @map("input_mode")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  session IdeaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_messages")
}

/// my_ideas stores the final distilled output of a completed session.
/// The `vector` column uses pgvector's vector(768) type which Prisma
/// treats as Unsupported; raw SQL is used for writes/vector queries.
model MyIdea {
  id            Int      @id @default(autoincrement())
  /// pgvector embedding — 768 dimensions (nomic-embed-text-v1.5)
  vector        Unsupported("vector(768)")?
  rawText       String   @map("raw_text")
  distilledText String   @map("distilled_text")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("my_ideas")
}
