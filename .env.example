# Required: absolute path to your local Markdown vault (e.g. Obsidian vault)
BRAIN_VAULT_PATH=/Users/you/Documents/brain-vault

# Required: DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...

# Required by the read-only GitHub MCP server configured in mcp.json
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...

# Optional: server port (default shown)
PORT=5001

# Optional: enable Apple Reminders sync after a finished session
REMINDERS_SYNC_ENABLED=false

# Optional: MCP configuration path (default: ./mcp.json)
# MCP_CONFIG_PATH=/absolute/path/to/mcp.json

# Optional: prefixed MCP tool and artifact folder used as the Obsidian Vault
OBSIDIAN_MCP_WRITE_TOOL=obsidian_create-note
OBSIDIAN_NOTE_FOLDER=Brainstorm

# Optional: persistence backend for Obsidian notes. Use 'auto' to prefer CLI then fall back to MCP.
OBSIDIAN_WRITE_BACKEND=auto
# Optional: CLI command and args used for Obsidian CLI writes. Use {path} / {relativePath} / {vault} placeholders.
OBSIDIAN_CLI_COMMAND=obsidian
OBSIDIAN_CLI_ARGS=["{path}"]
