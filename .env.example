# Required: absolute path to your local Markdown vault (e.g. Obsidian vault)
BRAIN_VAULT_PATH=/Users/you/Documents/brain-vault

# Required: PostgreSQL connection string (pgvector/pgvector:pg16 container)
DATABASE_URL=<protocol>://<user>:<password>@localhost:5432/adhd_healing

# Optional: LM Studio OpenAI-compatible endpoint (default shown)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Optional: embedding model loaded in LM Studio (default shown)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Optional: chat model loaded in LM Studio (default shown)
CHAT_MODEL=qwen2.5-7b-instruct

# Optional: max clarification turns before forced finalization (default shown)
MAX_CLARIFICATION_TURNS=3

# Optional: server port (default shown)
PORT=5001
