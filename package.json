  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prisma": "^6.12.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.21.0"
  }
